{%- comment -%}
  COBO configurator embed for Shopify.
  Paste into a "Custom Liquid" section on a Shopify page (or into a new page template).

  The viewer is served by GitHub Pages at https://jcolli40.github.io/cobo-configurator/.
  If the repo ever moves to another GitHub account, change jcolli40 in the two spots below.
  Everything else works as-is. The viewer sends the chosen options up to this page,
  the script below adds the matching Shopify variant to the cart, and then sends the
  cart contents back down so the viewer can show its cart preview.
{%- endcomment -%}

<div class="cobo-configurator" style="width:100%;max-width:1400px;margin:0 auto;">
  <iframe
    id="cobo-config-frame"
    src="https://jcolli40.github.io/cobo-configurator/"
    title="Compliance Board configurator"
    loading="lazy"
    style="width:100%;height:min(860px,92vh);min-height:620px;border:0;border-radius:12px;"
    allow="fullscreen; xr-spatial-tracking"></iframe>
</div>

<script>
(function () {
  var ALLOWED_ORIGIN = 'https://jcolli40.github.io';   // must match the iframe src
  var frame = document.getElementById('cobo-config-frame');

  function tell(msg) { frame.contentWindow.postMessage(msg, ALLOWED_ORIGIN); }
  function sendCart(added, updated) {
    return fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) { tell({ type: 'cobo:cart', cart: cart, added: !!added, updated: !!updated }); });
  }
  function removeLine(key) {                                     // used when a cart board is edited
    if (!key) return Promise.resolve();
    return fetch('/cart/change.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: 0 })
    });
  }

  window.addEventListener('message', function (e) {
    if (e.origin !== ALLOWED_ORIGIN) return;                     // ignore anything else
    var d = e.data || {};

    if (d.type === 'cobo:get-cart') { sendCart(false); return; }

    if (d.type === 'cobo:qty') {                                 // − / + / Remove on a board in the viewer's cart
      fetch('/cart/change.js', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: d.key, quantity: Math.max(0, parseInt(d.quantity, 10) || 0) })
      }).then(function () { return sendCart(false); });
      return;
    }

    if (d.type === 'cobo:go') {                                  // "View cart" / "Checkout" buttons
      if (d.path === '/cart' || d.path === '/checkout') window.location.href = d.path;
      return;
    }

    // cobo:add-to-cart adds a board; cobo:update replaces the cart line being edited (d.key) with the new board
    if (d.type !== 'cobo:add-to-cart' && d.type !== 'cobo:update') return;
    var p = d.payload || {};
    if (!p.variantId) {
      tell({ type: 'cobo:notice', text: 'That combination is not linked to a product yet. Please contact us and we will set it up.' });
      return;
    }
    var updating = d.type === 'cobo:update';
    removeLine(updating ? d.key : null).then(function () { return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{
          id: p.variantId,
          quantity: Math.max(1, parseInt(p.quantity, 10) || 1),
          properties: {                                         // shows on the order so production knows the build
            'Edge banding': p.edgeBanding,
            'Cap & stud finish': p.fastenerFinish,
            'Orientation': p.orientation,
            '_cobo': JSON.stringify(p.config || {})              // hidden: lets "Edit board" reopen this exact board
          }
        }]
      })
    }); })
    .then(function (r) { if (!r.ok) throw new Error('cart error'); return sendCart(true, updating); })
    .catch(function () { tell({ type: 'cobo:notice', text: 'Sorry, we could not add that to the cart. Please try again.' }); });
  });
})();
</script>
