{%- comment -%}
  COBO configurator embed for Shopify.
  Paste into a "Custom Liquid" section on a Shopify page (or into a new page template).

  The viewer is served by GitHub Pages at https://jcolli40.github.io/cobo-configurator/.
  If the repo ever moves to another GitHub account, change jcolli40 in the two spots below.
  Everything else works as-is. The viewer sends the chosen options up to this page,
  the script below adds the matching Shopify variant to the cart, and then sends the
  cart contents back down so the viewer can show its cart preview.
{%- endcomment -%}

<div class="cobo-configurator" style="width:100%;max-width:1400px;margin:0 auto;">
  <iframe
    id="cobo-config-frame"
    src="https://jcolli40.github.io/cobo-configurator/"
    title="Compliance Board configurator"
    loading="lazy"
    style="width:100%;height:min(860px,92vh);min-height:620px;border:0;border-radius:12px;"
    allow="fullscreen; xr-spatial-tracking; camera"></iframe>
</div>

<script>
(function () {
  var ALLOWED_ORIGIN = 'https://jcolli40.github.io';   // must match the iframe src
  var frame = document.getElementById('cobo-config-frame');

  // A shared design link looks like  /pages/design-your-board?cobo=size%3D24x36%26color%3DBlack...
  // Pass those settings on to the viewer so it opens that exact board.
  // Adding  ?test=1  to this page's address also turns on the viewer's testing tools (the "Load test image" button).
  var qs = new URLSearchParams(location.search);
  var shared = qs.get('cobo');
  var parts = [];
  if (shared) parts.push(shared);
  if (qs.get('test') === '1') parts.push('test=1');
  if (parts.length) frame.src = frame.src.split('?')[0] + '?' + parts.join('&');

  function tell(msg) { frame.contentWindow.postMessage(msg, ALLOWED_ORIGIN); }
  function sendCart(added, updated) {
    return fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) { tell({ type: 'cobo:cart', cart: cart, added: !!added, updated: !!updated }); });
  }
  function removeLine(key) {                                     // used when a cart board is edited
    if (!key) return Promise.resolve();
    return fetch('/cart/change.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: 0 })
    });
  }

  window.addEventListener('message', function (e) {
    if (e.origin !== ALLOWED_ORIGIN) return;                     // ignore anything else
    var d = e.data || {};

    if (d.type === 'cobo:get-cart') {
      tell({ type: 'cobo:page', url: location.origin + location.pathname });   // so "Share" links point at this store page
      sendCart(false);
      return;
    }

    if (d.type === 'cobo:qty') {                                 // − / + / Remove on a board in the viewer's cart
      fetch('/cart/change.js', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: d.key, quantity: Math.max(0, parseInt(d.quantity, 10) || 0) })
      }).then(function () { return sendCart(false); });
      return;
    }

    if (d.type === 'cobo:go') {                                  // "View cart" / "Checkout" buttons
      if (d.path === '/cart' || d.path === '/checkout') window.location.href = d.path;
      return;
    }

    // cobo:add-to-cart adds a board; cobo:update replaces the cart line being edited (d.key) with the new board
    if (d.type !== 'cobo:add-to-cart' && d.type !== 'cobo:update') return;
    var p = d.payload || {};
    if (!p.variantId) {
      tell({ type: 'cobo:notice', text: 'That combination is not linked to a product yet. Please contact us and we will set it up.' });
      return;
    }
    var updating = d.type === 'cobo:update';
    var qty = Math.max(1, parseInt(p.quantity, 10) || 1);
    var props = {                                               // shows on the order so production knows the build
      'Edge banding': p.edgeBanding,
      'Cap & stud finish': p.fastenerFinish,
      'Orientation': p.orientation,
      'Logo': p.logoNote || undefined,                           // file name, size and Top/Bottom
      '_cobo': JSON.stringify(p.config || {})                    // hidden: lets "Edit board" reopen this exact board
    };
    // A logo file goes to Shopify with the cart line (multipart): Shopify stores it and the order shows a link ("Logo file").
    // Accept only an SVG or EPS under 12 MB; anything else is left off (the customer is told).
    var file = d.logoFile, sendFile = false;
    if (file && typeof file === 'object' && typeof file.name === 'string' && typeof file.size === 'number') {
      if (/\.(svg|eps)$/i.test(file.name) && file.size > 0 && file.size <= 12 * 1024 * 1024) sendFile = true;
      else { tell({ type: 'cobo:notice', text: 'We could not attach that logo file (SVG or EPS, up to 12 MB). Please email it to us.' }); }
    }
    removeLine(updating ? d.key : null).then(function () {
      if (!sendFile) {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: p.variantId, quantity: qty, properties: props }] })
        });
      }
      var fd = new FormData();                                   // (the browser sets the multipart header itself)
      fd.append('id', p.variantId);
      fd.append('quantity', qty);
      Object.keys(props).forEach(function (k) { if (props[k] !== undefined && props[k] !== null) fd.append('properties[' + k + ']', props[k]); });
      fd.append('properties[Logo file]', file, file.name);
      return fetch('/cart/add.js', { method: 'POST', body: fd });
    })
    .then(function (r) {
      if (r.status === 413) { tell({ type: 'cobo:notice', text: 'That logo file is too big to attach. Please use a smaller SVG or EPS.' }); throw new Error('too big'); }
      if (!r.ok) throw new Error('cart error');
      return sendCart(true, updating);
    })
    .catch(function (e) { if (!e || e.message !== 'too big') tell({ type: 'cobo:notice', text: 'Sorry, we could not add that to the cart. Please try again.' }); });
  });
})();
</script>
